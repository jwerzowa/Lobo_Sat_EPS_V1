	(text "RAIL A 3.3 V / RAIL B 5 V (2X LMZM33602)"
		(exclude_from_sim no)
		(at 241.22 183.34 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9064e423-c9ae-54a4-b87f-4798bf835fb4")
	)
	(text "Values from LMZM33602 datasheet Table 7-1 (RFBB = 10k): 3.3 V -> RFBT 23.2k, CFF 150 pF,"
		(exclude_from_sim no)
		(at 241.22 189.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "eeeea047-2ded-5da6-9964-8c3070d467ac")
	)
	(text "  RT 133k (300 kHz), COUT >= 88 uF; 5 V -> RFBT 40.2k, CFF 100 pF, RT 88.7k (450 kHz), COUT >= 66 uF."
		(exclude_from_sim no)
		(at 241.22 192.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1c8dd829-662d-5c44-a5fd-bb6f1918775c")
	)
	(text "AGND must NOT be tied to PGND externally (datasheet 5): each module has its own AGND net."
		(exclude_from_sim no)
		(at 241.22 195.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0b68a4ea-dbd1-5db2-bca4-6110327401e6")
	)
	(text "Pins 12/13 are DNC (no symbol pin). SW pins only go to a small copper island."
		(exclude_from_sim no)
		(at 241.22 198.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "09aae3be-6af0-5de0-892a-d693bae50b71")
	)
	(text "WARNING: datasheet recommends VIN >= 1.3 x VOUT = 6.5 V for the 5 V rail; pack goes to 6.0 V."
		(exclude_from_sim no)
		(at 241.22 201.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ac58f34a-ce56-5b97-b16e-fcd516e3a7d3")
	)
	(text "EN tied to VIN (allowed by datasheet). Add an EN divider later if you want a UVLO."
